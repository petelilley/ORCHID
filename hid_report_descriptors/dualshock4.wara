#
# Report descriptor adapted from
# https://github.com/DJm00n/ControllersInfo/blob/82c1d04494df9886b0f35f77e2435b5e3938575b/dualshock4/dualshock4_hid_report_descriptor.txt
#
# Only includes inputs, no outputs
#

[[applicationCollection]]
usage = ['Generic Desktop', 'Gamepad']

    [[applicationCollection.inputReport]]

        # Left Stick X
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Generic Desktop', 'X']
        logicalValueRange = [0, 255]

        # Left Stick Y
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Generic Desktop', 'Y']
        logicalValueRange = [0, 255]

        # Right Stick X
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Generic Desktop', 'Z']
        logicalValueRange = [0, 255]

        # Right Stick Y
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Generic Desktop', 'Rz']
        logicalValueRange = [0, 255]

        # D-Pad
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Generic Desktop', 'Hat Switch']
        logicalValueRange = [0, 7]
        physicalValueRange = [0, 315]
        unit = 'degrees'

        # Padding bit
        [[applicationCollection.inputReport.paddingItem]]
        sizeInBits = 1

        # Buttons
        [[applicationCollection.inputReport.variableItem]]
        usageRange = ['Button', 'Button 1', 'Button 14']
        logicalValueRange = [0, 1]

        # 6 Padding bits
        [[applicationCollection.inputReport.paddingItem]]
        sizeInBits = 6

        # Left Trigger
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Generic Desktop', 'Rx']
        logicalValueRange = [0, 255]

        # Right Trigger
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Generic Desktop', 'Ry']
        logicalValueRange = [0, 255]

