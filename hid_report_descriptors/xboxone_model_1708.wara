#
# Report descriptor adapted from
# https://github.com/DJm00n/ControllersInfo/blob/82c1d04494df9886b0f35f77e2435b5e3938575b/xboxone/xboxone_model_1708_firmware_5_17_hid_report_descriptor.txt
#
# Only includes inputs, no outputs
#

[[applicationCollection]]
usage = ['Generic Desktop', 'Gamepad']

    [[applicationCollection.inputReport]]
    id = 1

        [[applicationCollection.inputReport.physicalCollection]]
        usage = ['Generic Desktop', 'Pointer']

            # Left Stick X
            [[applicationCollection.inputReport.physicalCollection.variableItem]]
            usage = ['Generic Desktop', 'X']
            logicalValueRange = [0, 65535]

            # Left Stick Y
            [[applicationCollection.inputReport.physicalCollection.variableItem]]
            usage = ['Generic Desktop', 'Y']
            logicalValueRange = [0, 65535]

        [[applicationCollection.inputReport.physicalCollection]]
        usage = ['Generic Desktop', 'Pointer']

            # Right Stick X
            [[applicationCollection.inputReport.physicalCollection.variableItem]]
            usage = ['Generic Desktop', 'Z']
            logicalValueRange = [0, 65535]

            # Right Stick Y
            [[applicationCollection.inputReport.physicalCollection.variableItem]]
            usage = ['Generic Desktop', 'Rz']
            logicalValueRange = [0, 65535]

        # Left Trigger
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Simulation Controls', 'Brake']
        logicalValueRange = [0, 1023]

        # 6 Padding bits
        [[applicationCollection.inputReport.paddingItem]]
        sizeInBits = 6

        # Right Trigger
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Simulation Controls', 'Accelerator']
        logicalValueRange = [0, 1023]

        # 6 Padding bits
        [[applicationCollection.inputReport.paddingItem]]
        sizeInBits = 6

        # D-Pad
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Generic Desktop', 'Hat Switch']
        logicalValueRange = [0, 8]
        physicalValueRange = [0, 315]
        unit = 'degrees'

        # 4 Padding bits
        [[applicationCollection.inputReport.paddingItem]]
        sizeInBits = 4

        # Buttons
        [[applicationCollection.inputReport.variableItem]]
        usageRange = ['Button', 'Button 1', 'Button 15']
        logicalValueRange = [0, 1]

        # 1 Padding bit
        [[applicationCollection.inputReport.paddingItem]]
        sizeInBits = 1

        # Record
        [[applicationCollection.inputReport.variableItem]]
        usage = ['Consumer', 'Record']
        logicalValueRange = [0, 1]

        # 7 Padding bits
        [[applicationCollection.inputReport.paddingItem]]
        sizeInBits = 7

